# --- Aplikasi ---
ENV=development
API_PREFIX=/api/v1
# Daftar origin FE, pisahkan dengan koma (tanpa wildcard di produksi)
CORS_ORIGINS=http://localhost:5173
# Zona waktu untuk tanggal/hari transaksi
TIMEZONE=Asia/Jakarta

# --- Sesi / Auth ---
# Minimal 32 karakter acak. Contoh membuat: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=12
# false hanya untuk development lokal (http). Produksi WAJIB true (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Buat hash dengan: python scripts/hash_password.py
# Bungkus dengan tanda kutip tunggal karena hash mengandung karakter $
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD_HASH=
ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD_HASH=

# --- Upload ---
MAX_UPLOAD_MB=5

# --- Cache ---
CACHE_TTL_SECONDS=30

# --- Google Sheets (lihat docs/PANDUAN_INTEGRASI_GOOGLE_SHEETS.md) ---
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
SPREADSHEET_ID=
SPREADSHEET_URL=

# --- AI (ekstraksi invoice) ---
GEMINI_API_KEY=
